{
  "name": "akaire",
  "version": "1.28.0",
  "description": "AIが生成した自己完結HTMLに、ブラウザ上で直接コメントを入れ、AIへ渡して直させ、直った分が自動で「済み」へ落ちるレビューの往復を成立させるレイヤー",
  "license": "MIT",
  "browser": "rv-layer.js",
  "files": [
    "examples/",
    "prompts/",
    "rv-layer.js",
    "specs/",
    "templates/",
    "tools/"
  ],
  "bin": {
    "rv-cli": "tools/rv-cli.mjs"
  },
  "scripts": {
    "test": "node tests/static-checks.mjs && node tests/roundtrip.mjs && node tests/images.mjs && node tests/environment.mjs",
    "test:static": "node tests/static-checks.mjs",
    "test:browser": "node tests/roundtrip.mjs",
    "test:images": "node tests/images.mjs",
    "test:environment": "node tests/environment.mjs",
    "serve": "python3 -m http.server 8000"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "html",
    "review",
    "annotation",
    "ai",
    "claude",
    "codex",
    "feedback"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevin-slvc/akaire.git"
  },
  "bugs": {
    "url": "https://github.com/kevin-slvc/akaire/issues"
  },
  "homepage": "https://github.com/kevin-slvc/akaire#readme",
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
